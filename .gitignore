# ─────────────────────────────────────────────
#  Village Simulation — monorepo .gitignore
# ─────────────────────────────────────────────

# --- Secrets / local env ---
.env
.env.*
!.env.example

# --- Node / Frontend ---
node_modules/
dist/
dist-ssr/
*.local
vite-dev.log

# --- Python / Backend ---
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Runtime data (regenerated on run) ---
*.db
*.sqlite
*.sqlite3
chroma_data/
uvicorn.log
*.log

# --- Third-party art assets (not redistributable; repo is public) ---
Tilesets/
Frontend/public/tilesets/

# --- Tiled map: source + derived export (not published for now) ---
untitled.tmx
untitled.tiled-project
Frontend/public/maps/village.json

# --- Working notes for Claude Code sessions (not published) ---
PROJECT_STATUS.md
CHANGELOG_ARCHIVE.md
ㄱㅍ.txt

# --- Backups ---
*.bak
*.bak-*
*.bak.*

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# --- Tiled editor session (local UI state) ---
*.tiled-session

# --- Claude Code local settings ---
.claude/settings.local.json
