# --- Relational DB (MySQL) ---
# Production/target DB per GDD. Requires: pip install pymysql cryptography
# Example: mysql+pymysql://root:password@localhost:3306/village_db
# Leave unset (or use the sqlite line) to run locally without installing MySQL.
DATABASE_URL=sqlite:///./village.db
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/village_db

# --- Vector DB (ChromaDB) ---
CHROMA_PATH=./chroma_data

# --- LLM: Game Master brain (reflection / routine JSON / eavesdrop script) ---
# If left empty, the backend runs in deterministic fallback mode (no API calls),
# so the whole stack is testable without cost/key.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.9

# --- LLM: NPC dialogue brain (/chat only) ---
# Leave DIALOGUE_BASE_URL empty to reuse the GM client/model above (single-model mode, default).
# To route NPC dialogue to a local uncensored model (e.g. Llama-3-8B-Instruct-abliterated via Ollama):
#   1. Install Ollama, then: ollama pull <your-abliterated-model-tag>
#   2. Ollama serves an OpenAI-compatible endpoint at http://localhost:11434/v1 by default
#   3. Set the two lines below to match
# DIALOGUE_BASE_URL=http://localhost:11434/v1
# DIALOGUE_MODEL=llama3-8b-instruct-abliterated
DIALOGUE_BASE_URL=
DIALOGUE_MODEL=gpt-4o-mini
DIALOGUE_API_KEY=ollama
DIALOGUE_TEMPERATURE=1.0

# --- Game / World ---
# 1 real second = GAME_MINUTES_PER_REAL_SECOND game-minutes
GAME_MINUTES_PER_REAL_SECOND=1
PASSOUT_HOUR=2
WAKE_HOUR=8

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
